NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=

# Immutable release identity. Vercel supplies VERCEL_GIT_COMMIT_SHA; the
# explicit build SHA is for equivalent non-Vercel staging builds only.
BLUNDR_RELEASE_ID=
BLUNDR_FEATURE_PROFILE_ID=
BLUNDR_MIGRATION_HEAD=
BLUNDR_BUILD_GIT_SHA=
BLUNDR_RELEASE_EVIDENCE_TOKEN=

# Production/staging Maia must use an authenticated HTTPS service. Local lc0
# paths are accepted only outside NODE_ENV=production.
NEXT_PUBLIC_MAIA_API_ENABLED=false
MAIA_ENABLED=false
MAIA_REMOTE_URL=
MAIA_REMOTE_HEALTH_URL=
MAIA_REMOTE_TOKEN=
MAIA_SKILL_LEVEL=maia-1500
MAIA_TIMEOUT_MS=1500
NEXT_PUBLIC_BLUNDR_ONBOARDING_V11=false

# Server-controlled capabilities. Values are 1/true/yes/on; absent values fail closed.
BLUNDR_FEATURE_GAME_DATA_CONNECTIONS=false
BLUNDR_FEATURE_GAME_DATA_CHESS_COM=false
BLUNDR_FEATURE_GAME_DATA_LICHESS=false
BLUNDR_FEATURE_PROVIDER_INGESTION=false
BLUNDR_FEATURE_DAILY_PRODUCTION_STORE=false
BLUNDR_FEATURE_DAILY_DEEP_MINIGAMES=false
BLUNDR_FEATURE_LEARNING_CORE_V2=false
BLUNDR_FEATURE_LEARNING_CORE_V2_WRITE=false
BLUNDR_FEATURE_LEARNING_CORE_V2_READ=false
BLUNDR_FEATURE_WEAKNESS_ENGINE=false
BLUNDR_FEATURE_WEAKNESS_ENGINE_V2=false
BLUNDR_FEATURE_OPENING_ACCESS_V2=false
BLUNDR_FEATURE_REPERTOIRE_OPENING_DETAIL=false
BLUNDR_FEATURE_DAILY_CORE_V2=false
BLUNDR_FEATURE_MIXED_TEST=false
BLUNDR_FEATURE_DAILY_CANDIDATE_CHOICE=false
BLUNDR_FEATURE_DAILY_PLAN_RECALL=false
BLUNDR_FEATURE_DAILY_SAME_POSITION_DIFFERENT_ROUTE=false
BLUNDR_FEATURE_DAILY_CONTINUATION_CHALLENGE=false
BLUNDR_FEATURE_DAILY_PUNISH_THE_MISTAKE=false
BLUNDR_FEATURE_DAILY_MIXED_TEST=false
BLUNDR_FEATURE_DAILY_DEEP_MINIGAMES=false

BLUNDR_DEV_TOOLS_ENABLED=false
BLUNDR_ADMIN_EMAILS=
BLUNDR_ADMIN_USER_IDS=

# local_or_supabase, local_demo, authenticated, developer_admin
NEXT_PUBLIC_BLUNDR_STORAGE_MODE=local_or_supabase

# Required by the staging-3.99 profile. Operational events are best-effort,
# but staging cannot claim ready without an external telemetry sink.
BLUNDR_TELEMETRY_ENDPOINT=
BLUNDR_TELEMETRY_TOKEN=

# Optional Sentry error and performance monitoring.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ENVIRONMENT=
# Build-only source-map upload configuration. Never expose these as NEXT_PUBLIC_*.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
